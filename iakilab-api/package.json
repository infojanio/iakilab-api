{
  "name": "iakilab-api",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node build/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:homolog": "tsx scripts/migrate-homolog.ts",
    "bootstrap:homolog": "tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.0.1",
    "@fastify/jwt": "10.2.6",
    "@fastify/multipart": "9.3.0",
    "@fastify/rate-limit": "10.2.1",
    "@prisma/client": "6.1.0",
    "bcryptjs": "2.4.3",
    "fastify": "5.12.7",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.5",
    "prisma": "6.1.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}

NODE_ENV=development
APP_ENV=homologation
DATABASE_URL=postgresql://iakilab:CHANGE_ME@127.0.0.1:5433/iakilab_homolog?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS_BEFORE_RUNNING
WEB_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
STORAGE_ROOT=./private-storage
PORT=3333

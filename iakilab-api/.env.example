NODE_ENV=development
APP_ENV=homologation
ENABLE_REPORT_RECTIFICATION=false
DATABASE_URL=postgresql://iakilab:CHANGE_ME@127.0.0.1:5433/iakilab?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS_BEFORE_RUNNING
WEB_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
STORAGE_ROOT=./private-storage
PORT=3333
# Bootstrap reads ADMIN_EMAIL, ADMIN_NAME and ADMIN_PASSWORD only from environment.
# No default account or password is shipped.

# Issuance is optional. Configure one entry with its own files per laboratory UUID.
# A1_LABORATORIES_JSON='[{"laboratoryId":"33333333-3333-4333-8333-333333333333","certificate":"/run/secrets/lab-a1.p12","passwordFile":"/run/secrets/lab-a1-password","trustRoot":"/run/secrets/lab-a1-trust-root.pem"}]'
# For a single laboratory, use the individual certificate variables below instead.
# A1_LABORATORY_ID=
# A1_CERTIFICATE_PATH=/run/secrets/lab-a1.p12
# A1_PASSWORD_FILE=/run/secrets/lab-a1-password
# A1_TRUST_ROOT=/run/secrets/lab-a1-trust-root.pem
# A1_INTERMEDIATE_CHAIN=/run/secrets/lab-a1-intermediates.pem
# A1_PYTHON=python3
# PUBLIC_REPORT_ORIGIN=http://localhost:5173
# LEGACY_A1_TRUST_ROOT=/run/secrets/lab-legacy-trust-root.pem
# Cadastro pelo painel. Gere uma chave exclusiva com openssl rand -hex 32.
# A1_MANAGEMENT_KEY=
